     <Border x:Name="ToolbarBar" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0"><Grid x:Name="Toolbar" Background="Transparent" Margin="9,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="218"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BackButton" Style="{StaticResource Icon}" Content="&#xE72B;" ToolTip="Back (Alt+Left)"/><Button x:Name="ForwardButton" Style="{StaticResource Icon}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)"/><Button x:Name="ReloadButton" Style="{StaticResource Icon}" ToolTip="Reload (Ctrl+R)" AutomationProperties.Name="Reload page"><TextBlock x:Name="ReloadGlyph" Text="&#xE72C;" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock></Button></StackPanel>
