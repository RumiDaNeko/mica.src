    <StackPanel><Grid Margin="16,10,14,17"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBox x:Name="SpotlightInput" Grid.Column="1" FontSize="21" BorderThickness="0" Background="Transparent" Padding="7,9" AutomationProperties.Name="Search tabs, bookmarks, history or the web"/><Button x:Name="DismissSpotlight" Grid.Column="2" Content="esc" FontSize="10" Foreground="{DynamicResource Muted}" Padding="3" ToolTip="Close Spotlight"/></Grid>
