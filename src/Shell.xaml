     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="8,12,8,0" Padding="9,12,9,4"><Grid><TextBlock Text="↑ ↓  to navigate       ↵  to open" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="A shortcut to anywhere." FontFamily="{DynamicResource SerifFont}" FontStyle="Italic" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></Grid></Border>
    </StackPanel>
   </Border></Grid>
  </Grid>
 </Grid>
</Window>


