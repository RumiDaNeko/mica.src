     </Grid></Border>
     <Grid x:Name="PageSurface" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="Home" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Grid Margin="40,26,40,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#7C977D" Margin="0,0,8,0"/><TextBlock Text="ROOM TO THINK" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="DateLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}"/></Grid>
        <StackPanel x:Name="HomeColumn" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="640" Margin="0,30,0,30">
         <Grid Height="260">
          <Viewbox x:Name="HomeArtwork" Width="340" Height="260" Opacity="0.32" IsHitTestVisible="False"><Canvas Width="220" Height="210"><Ellipse Width="155" Height="155" Canvas.Left="32" Canvas.Top="27" Fill="#E6DFED"/><Ellipse Width="118" Height="118" Canvas.Left="50" Canvas.Top="46" Fill="#F4F0F7"/><Ellipse Width="78" Height="78" Canvas.Left="70" Canvas.Top="66" Fill="#D1C2E0"/><Ellipse Width="200" Height="68" Canvas.Left="10" Canvas.Top="72" Stroke="#9584AB" StrokeThickness="1" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-38"/></Ellipse.RenderTransform></Ellipse><Ellipse Width="200" Height="68" Canvas.Left="10" Canvas.Top="72" Stroke="#B0A0C2" StrokeThickness="1" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="38"/></Ellipse.RenderTransform></Ellipse><Ellipse Width="13" Height="13" Fill="#6F5B89" Canvas.Left="174" Canvas.Top="53"/><Ellipse Width="7" Height="7" Fill="#AF9AC5" Canvas.Left="30" Canvas.Top="156"/></Canvas></Viewbox>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="HomeHeadline" Text="9:41" FontFamily="{DynamicResource SerifFont}" FontSize="76" HorizontalAlignment="Center" Foreground="{DynamicResource Ink}"/><TextBlock x:Name="Greeting" Text="Hello, you." FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
         </Grid>
         <Button x:Name="HomeSearch" Background="{DynamicResource Panel}" Padding="22,17" Margin="0,22,0,0" HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource Line}"><Button.Effect><DropShadowEffect Color="#A69AAA" BlurRadius="30" ShadowDepth="4" Opacity="0.12"/></Button.Effect><Grid><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock Text="Search or type a web address" Foreground="{DynamicResource Muted}" Margin="30,0,0,0" FontSize="14"/><Border HorizontalAlignment="Right" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="7,2"><TextBlock Text="Ctrl+K" FontSize="10" Foreground="{DynamicResource Muted}"/></Border></Grid></Button>
         <Grid Margin="4,34,4,12"><TextBlock Text="YOUR EVERYDAY" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><TextBlock Text="Most visited" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid>
