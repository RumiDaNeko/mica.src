        </StackPanel>
        <Grid Grid.Row="2"><TextBlock Text="Less noise. More internet." FontFamily="{DynamicResource SerifFont}" FontStyle="Italic" FontSize="12" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PersonalizeButton" Content="Personalize  ↗" FontSize="10" Foreground="{DynamicResource Muted}" Padding="0,3" Margin="0,0,18,0"/><Button x:Name="ShortcutsButton" Content="Keyboard shortcuts  ↗" FontSize="10" Foreground="{DynamicResource Muted}" Padding="0,3"/></StackPanel></Grid>
       </Grid>
      </ScrollViewer>
      <Grid x:Name="WebHost" Visibility="Collapsed"/>
      <Border x:Name="ErrorPanel" Background="{DynamicResource Canvas}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"><TextBlock x:Name="ErrorTitle" Text="A small detour." FontFamily="{DynamicResource SerifFont}" FontSize="32" TextWrapping="Wrap"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,16" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal"><Button x:Name="RetryButton" Content="Try again" HorizontalAlignment="Left" Background="{DynamicResource Hover}"/><Button x:Name="InsecureButton" Content="Continue without HTTPS" Margin="8,0,0,0" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/><Button x:Name="GamesButton" Content="Play a game while you wait" Margin="8,0,0,0" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/></StackPanel></StackPanel></Border>
