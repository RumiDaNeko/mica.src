    </Grid>
   </Border>
  </Grid>
  <Border x:Name="ResizeGlow" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="12" Margin="2" Opacity="0" IsHitTestVisible="False"/>
