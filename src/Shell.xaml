    <StackPanel><StackPanel x:Name="TabItems"/><Button x:Name="NewTabButton" HorizontalContentAlignment="Left" Margin="0,5,0,0" Foreground="{DynamicResource Muted}" Content="＋   New tab" ToolTip="Ctrl+T"/></StackPanel>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="4"><Grid Margin="0,10,0,8"><Button x:Name="MenuButton" HorizontalAlignment="Left" Padding="12,10" ToolTip="Browser menu"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Menu"/></StackPanel></Button><Button x:Name="AvatarButton" Style="{StaticResource Icon}" HorizontalAlignment="Right" Margin="0,0,38,0" AutomationProperties.Name="Account"/><Button x:Name="ThemeButton" Style="{StaticResource Icon}" HorizontalAlignment="Right" Content="&#xE708;" ToolTip="Switch theme"/></Grid></StackPanel>
    <Grid x:Name="CompactRail" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Opacity="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock x:Name="BrandMark" Foreground="{DynamicResource Ink}" Text="M." FontFamily="pack://application:,,,/Assets/Brand/#Caveat" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,2" IsHitTestVisible="False" AutomationProperties.Name="Mica"/><Button x:Name="MiniSearch" HorizontalAlignment="Center" Style="{StaticResource Icon}" Content="&#xE721;" Margin="0,6,0,10" Background="{DynamicResource SideCard}" ToolTip="Spotlight (Ctrl+K)" AutomationProperties.Name="Search"/><Button x:Name="MiniSpace" HorizontalAlignment="Center" Style="{StaticResource Icon}" Content="&#xE8F1;" ToolTip="Choose a space" Margin="0,0,0,14"/><Border Background="{DynamicResource Line}" Height="1" Margin="7,0,7,10"/></StackPanel>
     <ScrollViewer x:Name="MiniTabScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel x:Name="MiniTabs"/><Button x:Name="MiniNewTab" HorizontalAlignment="Center" Style="{StaticResource Icon}" Content="&#xE710;" Margin="0,6,0,0" ToolTip="New tab (Ctrl+T)"/></StackPanel></ScrollViewer>
     <StackPanel Grid.Row="2" Margin="0,8"><Button x:Name="MiniAvatar" HorizontalAlignment="Center" Style="{StaticResource Icon}" Margin="0,0,0,8" AutomationProperties.Name="Account"/><Button x:Name="MiniTheme" HorizontalAlignment="Center" Style="{StaticResource Icon}" Content="&#xE708;" ToolTip="Switch theme"/><Button x:Name="MiniMenu" HorizontalAlignment="Center" Style="{StaticResource Icon}" Content="&#xE713;" ToolTip="Browser menu" Margin="0,8,0,0"/></StackPanel>
    </Grid>
   </Grid>
