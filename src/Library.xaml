<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Canvas}">
 <Grid Margin="38,28,38,18" MaxWidth="1000">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,25"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="MICA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text=" /  YOUR LIBRARY" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="HistorySection" Content="History" Padding="13,8"/><Button x:Name="DownloadsSection" Content="Downloads" Padding="13,8" Margin="4,0,0,0"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,25"><StackPanel><TextBlock x:Name="LibraryTitle" Text="History" FontFamily="{DynamicResource SerifFont}" FontSize="40"/><TextBlock x:Name="LibrarySubtitle" Text="Pick up a thought where you left it." Foreground="{DynamicResource Muted}" FontSize="12" Margin="1,10,0,0"/></StackPanel><Button x:Name="LibraryClear" Content="Clear history" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" Padding="12,9"/></Grid>
  <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBox x:Name="LibrarySearch" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0" FontSize="13" VerticalContentAlignment="Center" AutomationProperties.Name="Search library"/><TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search history" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/><Button x:Name="ClearLibrarySearch" Grid.Column="2" Content="×" Padding="0" ToolTip="Clear search"/></Grid></Border>
  </Grid>
  <StackPanel Grid.Row="3"><Grid Margin="0,0,0,15"><StackPanel Orientation="Horizontal"><Button x:Name="FilterAll" Content="All" Padding="13,7" FontSize="11"/><Button x:Name="FilterSecond" Content="Today" Padding="13,7" Margin="4,0,0,0" FontSize="11"/><Button x:Name="FilterThird" Content="Past 7 days" Padding="13,7" Margin="4,0,0,0" FontSize="11"/></StackPanel><TextBlock x:Name="LibraryCount" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Border x:Name="ClearConfirmation" Visibility="Collapsed" CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Panel}" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="Clear all browsing history?" FontWeight="SemiBold"/><TextBlock Text="Cookies, bookmarks and downloaded files will stay." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button x:Name="ConfirmClearHistory" Content="Clear history" Background="{DynamicResource Hover}"/><Button x:Name="CancelClearHistory" Content="Keep history" Margin="7,0,0,0"/></StackPanel></StackPanel></Border>
  </StackPanel>
  <Grid Grid.Row="4"><ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LibraryRows" Margin="0,0,8,12"/></ScrollViewer><StackPanel x:Name="LibraryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,30"><TextBlock x:Name="EmptyGlyph" Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,22"/><TextBlock x:Name="EmptyTitle" Text="A fresh page." FontFamily="{DynamicResource SerifFont}" FontSize="26" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDetail" Text="Your visited pages will appear here." Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="370" Margin="0,12,0,0"/></StackPanel></Grid>
  <TextBlock Grid.Row="5" x:Name="LibraryFootnote" Text="Your latest 500 unique pages, stored on this device." FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </Grid>
</Grid>
