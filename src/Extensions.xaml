<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="28,24,28,20">
 <Grid.Resources>
  <Style x:Key="Field" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Padding="0" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/><TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Grid.Resources>
 <Grid x:Name="ExtensionMain">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource Hover}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Extensions" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Your tools, all in one place" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/></StackPanel><Border Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource Hover}" CornerRadius="9" Padding="10,5" Margin="0,0,40,0"><TextBlock x:Name="ExtensionCount" Text="0 installed" FontSize="11" Foreground="{DynamicResource Accent}"/></Border></Grid>
  <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,22">
   <StackPanel><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Add from Chrome Web Store" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button x:Name="BrowseStore" Content="Browse store ↗" HorizontalAlignment="Right" FontSize="11" Padding="9,5"/></Grid>
    <TextBlock Text="Add directly on the store page. You can also paste a link here to review permissions." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,10,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StoreLink" Tag="Paste a Chrome Web Store link…" Style="{StaticResource Field}" ToolTip="https://chromewebstore.google.com/detail/name/extension-id" AutomationProperties.Name="Chrome Web Store extension link"/><Button x:Name="ReviewStore" Grid.Column="1" Content="Review extension" Background="{DynamicResource Hover}" Padding="14,8" Margin="10,0,0,0"/></Grid>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="FilterAllExtensions" Content="All" Background="{DynamicResource Hover}" Padding="12,7"/><Button x:Name="FilterEnabledExtensions" Content="Enabled" Padding="12,7" Margin="4,0"/><Button x:Name="FilterDisabledExtensions" Content="Disabled" Padding="12,7"/></StackPanel><TextBox x:Name="ExtensionSearch" Tag="Search extensions…" Grid.Column="1" Style="{StaticResource Field}" Padding="10,7" VerticalAlignment="Center" ToolTip="Find an extension by name" AutomationProperties.Name="Find an extension"/></Grid>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ExtensionRows"/></ScrollViewer>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,10"/><StackPanel x:Name="ExtensionCommands" Orientation="Horizontal"><Button x:Name="LoadUnpacked" Content="Load unpacked…" Padding="10,7" FontSize="11"/><Button x:Name="RefreshExtensions" Content="Refresh" Padding="10,7" FontSize="11" Margin="4,0"/><TextBlock Text="Shared across your spaces" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><ProgressBar x:Name="ExtensionProgress" Height="2" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/><TextBlock x:Name="ExtensionStatus" Text="Loading your extensions…" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/></StackPanel>
 </Grid>
 <Border x:Name="ExtensionReview" Background="{DynamicResource Canvas}" Visibility="Collapsed">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="BEFORE YOU ADD" FontSize="9" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="ReviewName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ReviewVersion" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/><TextBlock Text="Review the access this extension requests." Margin="0,22,0,14"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18"><TextBlock x:Name="ReviewPermissions" TextWrapping="Wrap" LineHeight="23" FontSize="12"/></Border><Border Background="{DynamicResource Hover}" CornerRadius="12" Padding="16" Margin="0,16,0,0"><TextBlock Text="Some Chrome features may not work in Mica yet, including toolbar popups. Installation doesn't guarantee compatibility. Store extensions don't update automatically in this version." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" LineHeight="20"/></Border></StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="CancelExtension" Content="Cancel" Padding="20,11" Margin="0,0,8,0"/><Button x:Name="ConfirmExtension" Content="Add extension" Background="{DynamicResource Hover}" Padding="20,11"/></StackPanel>
  </Grid>
 </Border>
</Grid>
