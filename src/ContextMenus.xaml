<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="ContextMenu">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource PopupPanel}"/>
  <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
  <Setter Property="MinWidth" Value="248"/><Setter Property="MaxWidth" Value="420"/><Setter Property="BorderBrush" Value="{DynamicResource PopupLine}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="6" SnapsToDevicePixels="True">
    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,1"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid>
    <Border x:Name="MenuRow" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
      <ContentPresenter x:Name="ItemIcon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
      <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Visibility="Collapsed" VerticalAlignment="Center"/>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="20,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="3" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="{DynamicResource ContextPopupAnimation}">
     <Border Background="{DynamicResource PopupPanel}" BorderBrush="{DynamicResource PopupLine}" BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="220">
      <ScrollViewer MaxHeight="{DynamicResource ContextMenuHeight}" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuRow" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
    <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuRow" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{DynamicResource Line}" Height="1" Margin="10,6"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
