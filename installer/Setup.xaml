<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="740" Height="530" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#F4EFF9" Title="Mica Setup">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F4EFF9"/><Setter Property="Background" Value="#51445F"/><Setter Property="Padding" Value="20,13"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#655474"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D2C7DD"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderBrush="#887697" BorderThickness="1" Background="#342B3F"><TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EFE4FA"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#61506F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border CornerRadius="22" Background="#28222F" BorderBrush="#54485F" BorderThickness="1" Padding="0" x:Name="Surface">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#362C42" CornerRadius="22,0,0,22" Padding="28,38"><Grid><TextBlock Text="M." FontFamily="pack://application:,,,/MicaSetup;component/assets/brand/#Caveat" FontSize="104" Margin="0,65,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="YOUR LITTLE" FontSize="10" Foreground="#BFAED0"/><TextBlock Text="corner of&#10;the internet." FontSize="25" FontFamily="Georgia" Margin="0,12,0,26"/><TextBlock Text="MICA / WINDOWS" FontSize="10" Foreground="#A695B5"/></StackPanel></Grid></Border>
   <Grid Grid.Column="1" Margin="34,70,34,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Eyebrow" Text="A SPACE THAT FEELS LIKE YOU" FontSize="10" Foreground="#B9A6CA"/><TextBlock x:Name="Heading" Text="Make yourself&#10;at home." FontFamily="Georgia" FontSize="37" Margin="0,16,0,15"/><TextBlock x:Name="Description" Text="A calmer browser, with room for everything you love." TextWrapping="Wrap" Foreground="#C5B8D0" FontSize="13" LineHeight="21"/></StackPanel>
    <Border Grid.Row="1" Background="#332B3D" CornerRadius="13" Padding="16" Margin="0,22,0,18"><StackPanel><StackPanel x:Name="CardTitle" Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="Everything comes with you" FontSize="12"/></StackPanel><TextBlock x:Name="CardDetail" Text="Browser engine included · No admin needed" Foreground="#BCAFCA" FontSize="11" Margin="0,7,0,0"/><TextBlock x:Name="InstallPath" Foreground="#A99AB8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/></StackPanel></Border>
    <StackPanel Grid.Row="2"><CheckBox x:Name="DesktopShortcut" Content="Add a desktop shortcut" IsChecked="True"/><ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#C9B1E5" Background="#44374F" BorderThickness="0" Margin="0,4,0,12"/><TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="11" Foreground="#C8BAD5" Margin="0,8,0,0"/></StackPanel>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Version" Text="0.12.31 · WINDOWS x64" Foreground="#9685A6" FontSize="10" VerticalAlignment="Center"/><Button x:Name="Action" Grid.Column="1" Content="Install Mica   →" FontWeight="SemiBold"/></Grid>
   </Grid>
   <Border x:Name="DragRegion" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="48" Background="Transparent" Margin="0,0,52,0"/>
   <Button x:Name="Close" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Width="30" Height="30" Padding="0" Background="Transparent" Content="×" FontSize="20" ToolTip="Close"/>
  </Grid>
 </Border>
</Window>
